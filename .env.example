# Copy these into your shell / service manager / IDE run configuration.
# (The app reads normal environment variables; no .env loader is required or included.)

SERVER_PORT=8088
BATCH_TABLE_PREFIX=BATCH_         # configurable prefix used for all Spring Batch metadata tables
DASHBOARD_ZONE=Asia/Kolkata       # time zone of the JVM that runs your batch jobs
DEFAULT_DB=dev

# --- Database 1 (blank URL = slot ignored; examples for MySQL and Oracle) ---
DB1_NAME=Development
DB1_ENV=DEV
DB1_URL=jdbc:mysql://localhost:3306/batch_db
DB1_USER=BATCH_VIEWER
DB1_PASSWORD=change-me
DB1_SCHEMA=                       # optional schema/database when different from the JDBC URL database
# Oracle example:
# DB1_URL=jdbc:oracle:thin:@//dev-host:1521/DEVPDB
# DB1_SCHEMA=BATCH_OWNER

# --- Database 2 ---
DB2_NAME=QA
DB2_ENV=QA
DB2_URL=
DB2_USER=
DB2_PASSWORD=

# --- Database 3 ---
DB3_NAME=Production
DB3_ENV=PROD
DB3_URL=
DB3_USER=
DB3_PASSWORD=
